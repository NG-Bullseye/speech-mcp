# speech-mcp — Umgebung. Kopiere nach .env (NICHT eingecheckt) und passe an.

# WhisperX STT-Endpoint (default: localhost)
WHISPERX_URL=http://localhost:48001

# TTS-Endpoint — ComfyUI oder kompatibler Service
TTS_URL=http://localhost:8188

# Mikrofon-Device (arecord -L)
MIC_DEVICE=hw:1,0

# Aufnahmen-Verzeichnis
RECORD_DIR=/tmp/speech-mcp-recordings
